<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../Config/etc/system_file.xsd">
    <system>
        <section id="payment">
            <group id="pinepgpaymentmethod" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Pay securely with Pine Labs</label>
                <field id="active" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Title</label>
                </field>
                <field id="cart" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Select Cart Type</label>
                  <source_model>Pinelabs\PinePGGateway\Model\Config\Source\Order\Status\PaymentCartType</source_model>
                </field>
                <field id="order_status" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>New Order Status</label>
                    <source_model>Pinelabs\PinePGGateway\Model\Config\Source\Order\Status\Pendingpayment</source_model>
                </field>
                <field id="MerchantId" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Merchant Id</label>
                   
                </field>
                <field id="MerchantAccessCode" translate="label" type="password" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Merchant Access Code</label>
                  
                </field>
				 <field id="MerchantSecretKey" translate="label" type="password" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Merchant Secret Key</label>
                 
                </field>
				 <field id="MerchantPaymentMode" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Merchant Payment Mode</label>
                 
                </field>
				  <field id="PayEnvironment" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Environment</label>
                  <source_model>Pinelabs\PinePGGateway\Model\Config\Source\Order\Status\PaymentEnvironment</source_model>
                </field>
				
                <!-- EMI Widget Settings -->
                <field id="emi_widget_enabled" translate="label" type="select" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable EMI Widget on Product Page</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Display EMI offers widget below Add to Cart button on product detail page. Product SKU will be used automatically.</comment>
                </field>
                
            </group>
            <!-- payment-group -->
        </section>
    </system>
</config>
