                                                </div>
                                            </div>
                                        <?php endforeach; ?>
                                    </div>
                                </div>
                            <?php endforeach; ?>
                        </div>
                    <?php endif; ?>
                </div>
            </div>
        </div>

        <script type="text/x-magento-init">
        {
            "#pinelabs-emi-widget": {
                "Pinelabs_PinePGGateway/js/emi-widget": {
