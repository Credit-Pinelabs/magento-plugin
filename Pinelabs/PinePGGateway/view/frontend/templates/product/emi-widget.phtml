                                                 alt="<?php echo $block->escapeHtml($issuer['issuer_name']); ?>" 
                                                 class="bank-logo-img" 
                                                 onerror="this.style.display='none';this.nextElementSibling.style.display='inline';" />
                                        <?php endif; ?>
                                        <span class="bank-name-text"><?php echo $block->escapeHtml($issuer['issuer_name']); ?></span>
                                        <?php $issuerCardLabel = $block->getCardTypeLabel($issuer['issuer_type'] ?? ''); ?>
                                        <?php if ($issuerCardLabel): ?>
                                            <span class="card-type-badge"><?php echo $issuerCardLabel; ?></span>
                                        <?php endif; ?>
                                    </h4>
