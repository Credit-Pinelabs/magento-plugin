<?php
/**
 * EMI Widget Template for Product Detail Page
 */
$writer = new \Zend_Log_Writer_Stream(BP . '/var/log/emi_widget_template.log');
$logger = new \Zend_Log();
$logger->addWriter($writer);
$logger->info('EMI Widget Template: Starting render');

if ($block->canDisplay()) {
    $logger->info('EMI Widget Template: canDisplay returned true');
    $noCostOffers = $block->getNoCostOffers();
    $allOffers = $block->getAllOffers();
    $minOffer = $block->getMinimumNoCostOffer();
    
    // Debug: Log minOffer data
    if (!empty($minOffer)) {
        $logger->info('EMI Widget Template: Min offer data', [
            'issuer_name' => $minOffer['issuer_name'] ?? 'N/A',
            'has_logo' => isset($minOffer['logo']) ? 'yes' : 'no',
            'logo_value' => $minOffer['logo'] ?? 'null',
            'all_keys' => implode(', ', array_keys($minOffer))
        ]);
    }
    
    // Debug: Log first issuer data
    if (!empty($allOffers)) {
        $firstIssuer = $allOffers[0];
        $logger->info('EMI Widget Template: First issuer data', [
            'issuer_name' => $firstIssuer['issuer_name'] ?? 'N/A',
            'has_logo' => isset($firstIssuer['logo']) ? 'yes' : 'no',
            'logo_value' => $firstIssuer['logo'] ?? 'null',
            'all_keys' => implode(', ', array_keys($firstIssuer))
        ]);
    }
    
    $logger->info('EMI Widget Template: Data fetched', [
        'noCostOffers_count' => count($noCostOffers),
        'allOffers_count' => count($allOffers),
        'has_minOffer' => $minOffer ? 'yes' : 'no'
    ]);
} else {
    $logger->info('EMI Widget Template: canDisplay returned false');
    return;
}
?>
    
    <?php
        // Fallback: if no no-cost offers, find the absolute minimum EMI across ALL issuers
        $displayOffer = $minOffer;
        $displayBadge = 'No Cost EMI';
        if (empty($displayOffer) && !empty($allOffers)) {
            $cheapestTenure = null;
            $cheapestIssuer = null;
            foreach ($allOffers as $issuer) {
                foreach ($issuer['tenures'] as $tenure) {
                    if ($tenure['tenure_months'] > 1 && ($cheapestTenure === null || $tenure['monthly_emi'] < $cheapestTenure['monthly_emi'])) {
                        $cheapestTenure = $tenure;
                        $cheapestIssuer = $issuer;
                    }
                }
            }
            if ($cheapestTenure && $cheapestIssuer) {
                $displayOffer = [
                    'issuer_name'   => $cheapestIssuer['issuer_name'],
                    'issuer_type'   => $cheapestIssuer['issuer_type'] ?? '',
                    'logo'          => $cheapestIssuer['logo'],
                    'monthly_emi'   => $cheapestTenure['monthly_emi'],
                    'tenure_months' => $cheapestTenure['tenure_months'],
                ];
                $displayBadge = 'EMI Available';
            }
        }
    ?>
    <?php if (!empty($displayOffer) || !empty($allOffers)): ?>
        <div class="pinelabs-emi-widget" id="pinelabs-emi-widget">
            
            <!-- EMI Header -->
            <?php if (!empty($displayOffer)): ?>
                <div class="emi-widget-header">
                    <div class="emi-header-content">
                        <div class="pinelabs-branding">
                            <span class="powered-by-text">Powered by</span>
                            <img src="https://www.pinelabs.com/img/logo.png" alt="Pinelabs" class="pinelabs-logo" />
                        </div>
                        <div class="emi-info">
                            <span class="emi-badge"><?php echo $displayBadge; ?></span>
                            <div class="emi-bank-info">
                                <?php if (!empty($displayOffer['logo'])): ?>
                                    <img src="<?php echo $block->getViewFileUrl('Pinelabs_PinePGGateway::images/banks/' . $displayOffer['logo']); ?>" 
                                         alt="<?php echo $block->escapeHtml($displayOffer['issuer_name']); ?>" 
                                         class="bank-logo-main" 
                                         onerror="this.style.display='none';" />
                                <?php endif; ?>
                                <span class="bank-name-main"><?php echo $block->escapeHtml($displayOffer['issuer_name']); ?></span>
                                <?php $cardLabel = $block->getCardTypeLabel($displayOffer['issuer_type'] ?? ''); ?>
                                <?php if ($cardLabel): ?>
                                    <span class="card-type-badge"><?php echo $cardLabel; ?></span>
                                <?php endif; ?>
                            </div>
                            <span class="emi-amount">Starting ₹<?php echo $block->formatAmount($displayOffer['monthly_emi']); ?>/month</span>
                        </div>
                    </div>
                    <button type="button" class="emi-show-all-btn" id="emi-show-all-btn">
                        View All EMI Options
                    </button>
                </div>
            <?php endif; ?>
        </div>

        <!-- EMI Modal Popup -->
        <div class="emi-modal" id="emi-modal" style="display: none;">
            <div class="emi-modal-overlay" id="emi-modal-overlay"></div>
